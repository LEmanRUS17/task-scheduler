server {
    listen 80;
    server_name localhost;
    root /var/www/html/public;
    index index.php;

    # Rendered from ${UPLOAD_MAX_SIZE} by the nginx entrypoint (envsubst).
    # Must be >= PHP post_max_size and cover the whole request body. For
    # multi-file (files[]) uploads it caps the *combined* size.
    client_max_body_size ${UPLOAD_MAX_SIZE};

    location / {
        try_files $uri /index.php$is_args$args;
    }

    location ~ \.php$ {
        fastcgi_pass php:9000;
        fastcgi_split_path_info ^(.+\.php)(/.*)$;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        include fastcgi_params;
    }

    location /.well-known/mercure {
        proxy_pass http://mercure/.well-known/mercure;
        proxy_buffering off;
        proxy_read_timeout 24h;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location ~ /\.(?!well-known).* {
        deny all;
    }
}
